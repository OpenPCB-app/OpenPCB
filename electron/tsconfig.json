{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": false,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "electron": ["node_modules/electron"],
      "@modules/*": ["src/modules/*"],
      "@sdks/*": ["src/sdks/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
