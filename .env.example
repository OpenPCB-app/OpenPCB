# OpenPCB Environment Configuration
# Copy this file to .env and configure for your environment

# Database Configuration
# Path to SQLite database file
# Default: {APP_DATA_DIR}/OpenPCB.db or ./data/OpenPCB.db
DB_FILE_PATH=./data/OpenPCB.db

# Application Data Directory
# Set by Rust layer at runtime, can be overridden for testing
# APP_DATA_DIR=

# Application Log Directory
# Set by Rust layer at runtime, can be overridden for testing
# APP_LOG_DIR=

# Server Configuration
# Bun backend HTTP server port (dynamically assigned by default)
# PORT=3000

# Environment Mode
# NODE_ENV=development

# Feedback Backend Configuration
# URL for the feedback collection API (default: http://localhost:3000/v1/feedback)
# VITE_FEEDBACK_API_URL=http://localhost:3000/v1/feedback
# API key for authenticating with the feedback/analytics backend
# Must match the API_KEY configured on the backend server
# VITE_FEEDBACK_API_KEY=your-secret-api-key

# ─── OpenPCB Cloud (optional — blank = offline desktop-only mode) ────
# Set the first three to enable cloud sync, AI features, library sync.
# VITE_CLOUD_WEB_URL is the Cloud website (dashboard) that hosts the browser
# login page; required for "Sign in to OpenPCB Cloud". Local dev → http://localhost:5173
# VITE_SUPABASE_URL=https://supabase.cloud.openpcb.app
# VITE_SUPABASE_ANON_KEY=
# VITE_CLOUD_API_URL=https://api.cloud.openpcb.app
# VITE_CLOUD_WEB_URL=https://dashboard.cloud.openpcb.app

# ─── Cloud auto-layout service (backend proxy target) ───────────────
# The desktop backend proxies the unified cloud Auto-Layout feature (auto-place +
# auto-route) to the merged cloud-auto-layout service, which serves BOTH /v1/route and /v1/place on
# one base URL. Default: http://localhost:3002 (devstack). Legacy AUTO_ROUTER_URL
# / AUTO_PLACE_URL are still read as fallbacks but should be replaced by this.
# AUTO_LAYOUT_URL=http://localhost:3002

# ─── Feature flags (dev-only by default) ────────────────────────────
# Cloud features are gated behind per-feature flags declared in
# src/core/contracts/feature-flags/registry.ts. Each flag is enabled in dev and
# hidden from production builds. Graduate a feature to prod by flipping its
# `availability` to "all" there. To force a flag in a build (e.g. QA on a
# release), set the matching override env var (1/true/on or 0/false/off):
#   frontend:  VITE_FEATURE_<FLAG>     e.g. VITE_FEATURE_CLOUD_AUTOLAYOUT=1
#   backend:   OPENPCB_FEATURE_<FLAG>  e.g. OPENPCB_FEATURE_CLOUD_AUTOLAYOUT=1
# <FLAG> = the flag name upper-cased with "." → "_" (cloud.autolayout → CLOUD_AUTOLAYOUT).
